{
  "name": "dsh-mcp-ui",
  "version": "1.0.2",
  "description": "MCP server management page for DeepSeek Harness Web Settings: live status, add/edit/enable/probe/restart/delete, and JSON import",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "mcp-server",
    "settings",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "readme.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/",
    "check": "node --check index.js && node --check client.js"
  },
  "license": "MIT"
}
